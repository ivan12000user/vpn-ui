#!/bin/bash
# Start/stop only the userspace awg1 network plumbing.
set -Eeuo pipefail
CONF=/etc/amnezia/amneziawg/awg1.conf
IF=awg1
VPN=10.88.88.0/24
WAN=ens3

case "${1:-}" in
  up)
    for i in $(seq 1 40); do
      ip link show "$IF" >/dev/null 2>&1 && break
      sleep 0.25
    done
    ip link show "$IF" >/dev/null
    tmp=$(mktemp /run/vpnui-awg1-config.XXXXXX)
    chmod 600 "$tmp"
    trap 'rm -f "$tmp"' EXIT
    /usr/bin/awg-quick strip "$CONF" >"$tmp"
    /usr/bin/awg setconf "$IF" "$tmp"
    ip address replace 10.88.88.1/24 dev "$IF"
    ip link set dev "$IF" mtu 1280 up
    /usr/sbin/iptables -t nat -C POSTROUTING -s "$VPN" -o "$WAN" -j MASQUERADE 2>/dev/null || \
      /usr/sbin/iptables -t nat -A POSTROUTING -s "$VPN" -o "$WAN" -j MASQUERADE
    /usr/sbin/iptables -C FORWARD -i "$IF" -o "$WAN" -j ACCEPT 2>/dev/null || \
      /usr/sbin/iptables -A FORWARD -i "$IF" -o "$WAN" -j ACCEPT
    ;;
  down)
    /usr/sbin/iptables -t nat -D POSTROUTING -s "$VPN" -o "$WAN" -j MASQUERADE 2>/dev/null || true
    /usr/sbin/iptables -D FORWARD -i "$IF" -o "$WAN" -j ACCEPT 2>/dev/null || true
    ip link del "$IF" 2>/dev/null || true
    ;;
  *)
    echo 'usage: vpn-ui-awg31-net up|down' >&2
    exit 64
    ;;
esac
